# Puerto del servidor
PORT=3000

# Rutas de persistencia (relativas a la raíz del proyecto o absolutas)
UPLOAD_DIR=./uploads

# Rate limit: peticiones por minuto por IP en la API
RATE_LIMIT_MAX=10

# Tamaño máximo del PDF en megabytes
MAX_PDF_MB=5

# Activa la política CSP para forzar HTTPS en los subrecursos (styles.css, form.js).
# Dejar en 0 (o sin definir) cuando la app se sirve por HTTP: en LAN o IP pública,
# "upgrade-insecure-requests" hace que el navegador pida los recursos por HTTPS y
# la página queda sin CSS ni JS (localhost no lo sufre por ser origen de confianza).
ENFORCE_HTTPS=0
